<odoo>

    <record id="view_base_automation_form_inherit" model="ir.ui.view">
        <field name="name">ir.actions.server.form.notify</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="mail.view_server_action_form_template" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mail_post_method']" position="after">
                <field
                    name="notify_method"
                    attrs="{
                        'invisible': [('state', '!=', 'notify')],
                        'required': [('state', '=', 'notify')]
                    }"
                />
                <field
                    name="notify_partner_ids"
                    widget="many2many_tags"
                    attrs="{
                        'invisible': [('template_id', '!=', False)],
                        'required': [('state', '=', 'notify'), ('template_id', '=', False)]
                    }"
                />
            </xpath>
        </field>
    </record>

